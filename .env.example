# Auth mode: "delegated" (default, device code flow), "application" (client credentials), or "token" (direct)
MS_AUTH_MODE=delegated

# Azure AD App Registration (required for delegated and application modes)
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id

# Only needed for application mode (client credentials)
AZURE_CLIENT_SECRET=your-client-secret

# Or skip all of the above and provide a token directly
# MS_GRAPH_ACCESS_TOKEN=your-access-token

# Optional: custom path for token cache (default: ./data/token-cache.json)
# MS_TOKEN_CACHE_PATH=/path/to/token-cache.json
